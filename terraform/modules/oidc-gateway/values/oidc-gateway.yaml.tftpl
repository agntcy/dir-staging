# OIDC Gateway Helm values generated by Terraform
# Based on the agntcy/oidc-gateway chart

envoy:
  replicaCount: ${envoy_replica_count}

  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi

  backend:
    address: "${dir_backend_address}"
    port: ${dir_backend_port}
    timeout: 30s
    streamingPath: "/agntcy.dir.events.v1.EventService/Listen"
    listenRouteTimeout: 0s

  oidc:
    issuers:
      - name: github
        enabled: ${github_enabled}
        issuer: "${github_issuer}"
        jwksUri: "${github_jwks_uri}"
        jwksHost: "${github_jwks_host}"
        audiences: ${jsonencode(github_audiences)}
%{ if google_enabled ~}
      - name: google
        enabled: true
        issuer: "${google_issuer}"
        jwksUri: "${google_jwks_uri}"
        jwksHost: "${google_jwks_host}"
        audiences: ${jsonencode(google_audiences)}
%{ endif ~}
%{ for custom_issuer in custom_issuers ~}
      - name: ${custom_issuer.name}
        enabled: ${custom_issuer.enabled}
        issuer: "${custom_issuer.issuer}"
        jwksUri: "${custom_issuer.jwks_uri}"
        jwksHost: "${custom_issuer.jwks_host}"
%{ endfor ~}
    jwksTimeout: 5s
    jwksCacheSeconds: 300
    allowMissing: true
    allowFailed: true

  spiffe:
    enabled: true
    trustDomain: ${trust_domain}
    className: ${className}

authServer:
  replicaCount: ${auth_server_replica_count}

  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi

  image:
    repository: ghcr.io/agntcy/oidc-gateway
    tag: v1.0.0
    pullPolicy: IfNotPresent

  config:
    listenAddress: ":9002"
    logLevel: info

  oidc:
    claims:
      principalClaim: "sub"
      emailClaimPath: "email"
    headers:
      authPrincipal: "x-auth-principal"
    issuers:
      - providerKey: "github"
        provider: "${github_issuer}"
        authFamily: "oidc"
      - providerKey: "google"
        provider: "${google_issuer}"
        authFamily: "oidc"
%{ for custom_issuer in custom_issuers ~}
      - providerKey: ${custom_issuer.name}
        provider: "${custom_issuer.issuer}"
        authFamily: "oidc"
%{ endfor ~}
    denyList: []
    publicPaths:
      - "/healthz"
      - "/grpc.reflection"
    roles:
      admin:
        allowedMethods: ["*"]
        principals: ${jsonencode(admin_principals)}
      viewer:
        allowedMethods:
          - "/agntcy.dir.store.v1.StoreService/Pull"
          - "/agntcy.dir.store.v1.StoreService/Lookup"
          - "/agntcy.dir.store.v1.StoreService/PullReferrer"
          - "/agntcy.dir.search.v1.SearchService/SearchCIDs"
          - "/agntcy.dir.search.v1.SearchService/SearchRecords"
        principals: ${jsonencode(viewer_principals)}
      ci-writer:
        allowedMethods:
          - "/agntcy.dir.store.v1.StoreService/Push"
          - "/agntcy.dir.store.v1.StoreService/PushReferrer"
          - "/agntcy.dir.store.v1.StoreService/Pull"
          - "/agntcy.dir.search.v1.SearchService/SearchCIDs"
          - "/agntcy.dir.search.v1.SearchService/SearchRecords"
        principals: ${jsonencode(ci_writer_principals)}

ingress:
  enabled: ${ingress_enabled}
  className: ${ingress_class}
  host: "${gateway_fqdn}"
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    external-dns.alpha.kubernetes.io/hostname: "${gateway_fqdn}"
    nginx.ingress.kubernetes.io/backend-protocol: "GRPC"
    nginx.ingress.kubernetes.io/grpc-backend: "true"
%{ for key, value in ingress_annotations ~}
    ${key}: "${value}"
%{ endfor ~}
  tls:
    enabled: true
    secretName: "oidc-gateway-tls"