project_id = <Google Cloud Project ID>
public_trust_domain = "example.agntcy.testbed"

# Managed-DNS inputs.
# The ExternalDNS GSA and IAM bindings are now created automatically if external_dns_gsa_email is not set.
# If you have a pre-existing GSA, set external_dns_gsa_email to the GSA email address.
base_domain            = <example.com>
dns_project_id         = <might match project_id>
dns_zone_name          = <example-com>
# external_dns_gsa_email = <external-dns@project-id.iam.gserviceaccount.com>  # Optional: if not set, GSA will be created automatically
# external_dns_gsa_name = "external-dns"  # Optional: name for auto-created GSA (default: "external-dns")

region     = "us-east1"
gke_cluster_name = "agntcy"
# Logical cluster name used in resource names and dir namespace (optional). Default: "public".
cluster_name = "public"
machine_type = "n2-standard-4"
acme_email = "alex.smith@example.com"
dir_chart_version = "v1.6.0"
zot_pvc_size = "50Gi"

# OIDC Gateway configuration (optional)
# Enables user authentication via external OIDC providers (GitHub, Google, etc.)
# The gateway validates tokens and enforces RBAC before forwarding to Directory API
# oidc_gateway_enabled = false  # Set to true to enable OIDC gateway
# oidc_gateway_chart_version = "v1.0.0"
# oidc_github_enabled = true  # Enable GitHub Actions OIDC
# oidc_google_enabled = true  # Enable Google OAuth
# oidc_admin_principals = ["oidc:github:your-username"]  # Users with full admin access
# oidc_viewer_principals = ["*"]  # All authenticated users have read access
# oidc_ci_writer_principals = ["oidc:github:repo:your-org/your-repo:workflow:*.yml"]  # CI workflows with write access
# oidc_ingress_enabled = true  # Expose gateway via ingress

# Federation configuration - list of trust domains to federate with
federates_with = ["spire.ads.outshift.io"]

# DIR-level federation peers configuration
# Each peer includes className, trustDomain, bundleEndpointURL, and bundleEndpointProfile with type
dir_federation_peers = [{
  className               = "dir-spire"
  trustDomain            = "spire.ads.outshift.io"
  bundleEndpointURL      = "https://spire.ads.outshift.io"
  bundleEndpointProfile  = {
    type = "https_web"
  }
}]

# Routing bootstrap peers for P2P network
dir_routing_bootstrap_peers = [
  "/dns4/routing.ads.outshift.io/tcp/5555/p2p/12D3KooWLf9p3cedc86xGQBaqak6rAFmQk1HxKAK1yh7umHE3amu"
]

# Routing autosync configuration (optional)
# Enables DHT-based record + referrer autosync from trusted peers
# routing_autosync_enabled = true
# routing_autosync_peerlist = ["12D3KooW...peerID1", "12D3KooW...peerID2"]

# Authorization policies for DIR apiserver (optional)
# If not specified, sensible defaults will be used that allow federation
# For custom policies, use a heredoc format:
# authz_policies_csv = <<-EOF
#   p,example.agntcy.testbed,*
#   p,*,/agntcy.dir.store.v1.StoreService/Pull
#   p,*,/agntcy.dir.store.v1.StoreService/PullReferrer
#   p,*,/agntcy.dir.store.v1.StoreService/Lookup
#   p,*,/agntcy.dir.store.v1.SyncService/RequestRegistryCredentials
#   EOF

# DIR Reconciler configuration (optional)
# The reconciler syncs records and OCI registry content from federated peers
# Defaults are production-ready based on AGNTCY recommendations
# reconciler_enabled = true
# reconciler_image_tag = "v1.3.0"
# reconciler_regsync_enabled = true
# reconciler_regsync_interval = "1m"
# reconciler_regsync_timeout = "30m"
# reconciler_indexer_enabled = true
# reconciler_indexer_interval = "30m"
