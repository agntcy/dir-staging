# Federation Configuration for CompanyXYZ AGNTCY Directory
# This file is automatically generated by Terraform
# Copy this content to: onboarding/federation/CompanyXYZ.com.yaml
# in the agntcy/dir-staging repository

# SPIRE Controller Manager class name (standard value)
className: dir-spire

# Trust Domain: Your SPIFFE trust domain
trustDomain: ${trust_domain}

# Bundle Endpoint URL: Your publicly accessible federation bundle endpoint
bundleEndpointURL: ${bundle_endpoint_url}

# Bundle Endpoint Profile: https_web (Let's Encrypt certificates)
bundleEndpointProfile:
  type: https_web